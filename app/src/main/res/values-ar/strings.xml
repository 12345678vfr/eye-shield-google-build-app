    <!-- 20-20-20 & Eye Health -->
    <string name="rule_20_20_title">قاعدة 20-20-20 لراحة العين</string>
    <string name="rule_20_20_desc">كل 20 دقيقة من النظر إلى الشاشة، انظر إلى مسافة 6 أمتار (20 قدماً) لمدة 20 ثانية لتجنب إجهاد العين الرقمي.</string>
    <string name="start_eye_rest">بدء استراحة 20 ثانية</string>
